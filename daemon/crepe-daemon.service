[Unit]
Description=Crêpe's brain (D-Bus service io.github.aceep.Crepe.Brain)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONPATH=%h/.local/share/crepe/daemon
ExecStart=%h/.local/share/crepe/daemon-venv/bin/python -m crepe_daemon
Restart=on-failure
RestartSec=5
# Exit status 2 is a bad daemon.toml: restarting would only fail again.
RestartPreventExitStatus=2
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
